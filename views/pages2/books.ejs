<main class="container my-5">
    <h1 class="mb-4">Books</h1>
        
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
        <% books.forEach(book => { %>
            <div class="col">
                <div class="card h-100 shadow-sm border-light position-relative">
                    
                   
                    <a href="/books/<%= book.id %>" class="text-decoration-none text-dark flex-grow-1 d-flex flex-column">
                        <img src="/images/<%= book.image ? book.image : 'default.jpg' %>" class="card-img-top" alt="<%= book.title %>" style="height: 180px; object-fit: cover; background: #eef2f4;">
                        
                        <div class="card-body d-flex flex-column">
                            <h2 class="card-title fs-5 mb-2"><%= book.title %></h2>
                            <p class="card-text text-muted mt-auto mb-0"><%= book.price %> грн</p>
                        </div>
                    </a>

                    
                    <div class="card-footer bg-white border-top-0 pt-0 pb-3 px-3">
                        <button class="btn btn-danger btn-sm w-100" onclick="deleteBook('<%= book.id %>')">
                            Видалити
                        </button>
                    </div>

                </div>
            </div>
        <% }) %>
    </div>
</main>


<script>
  async function deleteBook(id) {
    if (!confirm("Ви впевнені, що хочете видалити цю книжку?")) return;

    try {
      const response = await fetch(`/books/${id}`, {
        method: 'DELETE',
      });

      if (response.ok) {
        window.location.reload(); 
      } else {
        alert("Помилка при видаленні книжки");
      }
    } catch (error) {
      console.error("Error:", error);
    }
  }
</script>